# OpenAI-compatible API configuration.
# Copy this file to `.env.local` and fill in your values.
# These are read as Vite defaults; the in-app Settings modal can override
# them at runtime (stored in localStorage).
#
# Works with any OpenAI-compatible endpoint:
#   - OpenAI:        https://api.openai.com/v1
#   - OpenRouter:    https://openrouter.ai/api/v1
#   - Together AI:   https://api.together.xyz/v1
#   - NVIDIA NIM:    https://integrate.api.nvidia.com/v1
#   - xAI Grok:      https://api.x.ai/v1
#   - Gemini (OAI):  https://generativelanguage.googleapis.com/v1beta/openai
#   - Local LLMs:    http://localhost:1234/v1  (e.g. LM Studio)
#
# The browser talks to same-origin /api/openai (Vite middleware). The base URL
# below is sent as X-Upstream-Base-URL and forwarded by the proxy — the page
# never fetches the provider origin directly (avoids CORS from localhost:3000).

VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini
